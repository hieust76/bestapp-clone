// Prisma Schema for BestApp Digital Goods E-Commerce Platform
// Phase 2: Complete Database Schema Design with UUID, Full Relations & Indexes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  USER
  SUPPORT
  ADMIN
}

enum ProductType {
  ACCOUNT   // Tài khoản cấp sẵn (Email | Mật khẩu)
  CODE      // License Key / Key bản quyền kích hoạt
  UPGRADE   // Nâng cấp trực tiếp trên email/tài khoản khách hàng
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
}

enum DeliveryType {
  AUTO_ACCOUNT   // Tự động xuất user|pass
  AUTO_KEY       // Tự động xuất license key
  UPGRADE_LINK   // Tự động gửi link gia nhập family/team
  MANUAL         // Xử lý thủ công qua CSKH
}

enum OrderStatus {
  PENDING        // Đang chờ thanh toán
  PAID           // Đã thanh toán thành công
  PROCESSING     // Đang cấp phát hàng tự động
  DELIVERED      // Đã giao hàng thành công
  EXPIRED        // Đơn hàng quá hạn thanh toán (sau 30 phút)
  REFUNDED       // Đã hoàn tiền
  CANCELLED      // Đã hủy bởi người dùng hoặc admin
}

enum PaymentMethod {
  BANK_TRANSFER  // Chuyển khoản ngân hàng quét mã QR SePay 24/7
  MOMO           // Ví MoMo
  WALLET         // Số dư ví BestApp
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum LicenseStatus {
  AVAILABLE      // Sẵn sàng cấp phát
  ASSIGNED       // Đã gán cho đơn hàng đang xử lý
  DELIVERED      // Đã bàn giao cho khách hàng
  REVOKED        // Bị thu hồi / lỗi
}

enum CouponType {
  PERCENT        // Giảm theo %
  FIXED          // Giảm số tiền cố định (VND)
}

// -------------------------------------------------------------
// 1. USER & AUTH (Auth.js & RBAC)
// -------------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  name          String?
  role          Role           @default(USER)
  balance       Int            @default(0) // Số dư ví (VND)
  phone         String?
  image         String?
  emailVerified DateTime?

  // Relations
  orders        Order[]
  reviews       Review[]
  sessions      Session[]
  accounts      Account[]
  couponUsages  CouponUsage[]
  auditLogs     AuditLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -------------------------------------------------------------
// 2. CATEGORY (With Self-Relation Hierarchy)
// -------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  
  image       String?
  icon        String?
  sortOrder   Int        @default(0)
  isFeatured  Boolean    @default(false)

  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

// -------------------------------------------------------------
// 3. PRODUCT & VARIANTS
// -------------------------------------------------------------

model Product {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  shortDescription String?
  description      String          @db.Text
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  type             ProductType     @default(ACCOUNT)
  status           ProductStatus   @default(ACTIVE)
  isFeatured       Boolean         @default(false)
  
  coverImage       String
  images           String[]        @default([])
  badgeText        String?         // e.g. "Bán chạy", "Hot AI", "-60%"
  
  warrantyPolicy   String?         @db.Text
  instructionHtml  String?         @db.Text

  rating           Float           @default(5.0)
  totalSold        Int             @default(0)

  variants         ProductVariant[]
  reviews          Review[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductVariant {
  id           String        @id @default(uuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name         String        // e.g., "1 Tháng", "1 Năm", "Chính chủ mail cá nhân"
  price        Int           // Giá niêm yết (VND)
  salePrice    Int?          // Giá khuyến mãi (VND)
  stock        Int           @default(100)
  deliveryType DeliveryType  @default(AUTO_ACCOUNT)
  durationDays Int?          @default(30)
  sku          String?       @unique
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)

  licenses     License[]
  orderItems   OrderItem[]
  flashSales   FlashSale[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

// -------------------------------------------------------------
// 4. DIGITAL LICENSE & ACCOUNT INVENTORY
// -------------------------------------------------------------

model License {
  id                    String          @id @default(uuid())
  variantId             String
  variant               ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  codeEncrypted         String          @db.Text // Nội dung bảo mật: Key hoặc User|Pass hoặc Link
  status                LicenseStatus   @default(AVAILABLE)
  
  assignedToOrderItemId String?
  assignedToOrderItem   OrderItem?      @relation(fields: [assignedToOrderItemId], references: [id], onDelete: SetNull)

  deliveredAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([variantId, status])
  @@index([assignedToOrderItemId])
  @@map("licenses")
}

// -------------------------------------------------------------
// 5. ORDER & ORDER ITEMS
// -------------------------------------------------------------

model Order {
  id             String         @id @default(uuid())
  code           String         @unique // e.g. "BEST109283"
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  email          String         // Email nhận hàng (Bắt buộc với cả Guest Checkout)
  customerName   String?
  customerPhone  String?

  status         OrderStatus    @default(PENDING)
  totalAmount    Int            // Tổng tiền chưa giảm
  discountAmount Int            @default(0)
  finalAmount    Int            // Số tiền cần thanh toán

  paymentRef     String         @unique // Mã nội dung chuyển khoản SePay
  expiresAt      DateTime       // Thời điểm hết hạn (now + 30m)
  paidAt         DateTime?
  notes          String?

  items          OrderItem[]
  payments       Payment[]
  couponUsages   CouponUsage[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([code])
  @@index([email])
  @@index([status])
  @@index([paymentRef])
  @@index([expiresAt])
  @@map("orders")
}

enum ItemDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model OrderItem {
  id              String             @id @default(uuid())
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId       String
  variant         ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity        Int                @default(1)
  unitPrice       Int                // Giá đơn vị tại thời điểm mua
  productSnapshot Json               // Snapshot thông tin sản phẩm: { name, variantName, coverImage, deliveryType, durationDays }

  deliveryStatus  ItemDeliveryStatus @default(PENDING)
  deliveryData    String?            @db.Text

  licenses        License[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// -------------------------------------------------------------
// 6. PAYMENT & SEPAY WEBHOOK EVENTS (Idempotency)
// -------------------------------------------------------------

model Payment {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount      Int
  method      PaymentMethod  @default(BANK_TRANSFER)
  status      PaymentStatus  @default(PENDING)
  
  gatewayTxId String?        // ID giao dịch ngân hàng / SePay
  rawPayload  Json?          // Dữ liệu thô từ Webhook
  paidAt      DateTime?

  events      PaymentEvent[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([gatewayTxId])
  @@map("payments")
}

model PaymentEvent {
  id             String   @id @default(uuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  eventType      String   // "sepay.transaction.created" / "sepay.webhook"
  idempotencyKey String   @unique // Đảm bảo không xử lý webhook trùng lặp
  payload        Json
  processedAt    DateTime @default(now())

  @@index([idempotencyKey])
  @@index([paymentId])
  @@map("payment_events")
}

// -------------------------------------------------------------
// 7. COUPON & PROMOTIONS
// -------------------------------------------------------------

model Coupon {
  id          String        @id @default(uuid())
  code        String        @unique // e.g. "BESTAPP50", "WELCOME"
  description String?
  type        CouponType    @default(PERCENT)
  value       Int           // 10 = 10% hoặc 50000 = 50.000đ
  minOrder    Int           @default(0)
  maxDiscount Int?          // Số tiền giảm tối đa nếu là PERCENT
  maxUsage    Int           @default(100)
  usedCount   Int           @default(0)
  startsAt    DateTime      @default(now())
  expiresAt   DateTime?
  isActive    Boolean       @default(true)

  usages      CouponUsage[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  discountAmount Int
  usedAt         DateTime @default(now())

  @@index([couponId])
  @@index([orderId])
  @@index([userId])
  @@map("coupon_usages")
}

// -------------------------------------------------------------
// 8. FLASH SALE
// -------------------------------------------------------------

model FlashSale {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  salePrice Int            // Giá bán Flash sale
  stock     Int            @default(50)
  soldCount Int            @default(0)
  startsAt  DateTime       @default(now())
  endsAt    DateTime
  isActive  Boolean        @default(true)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([variantId])
  @@index([startsAt, endsAt])
  @@map("flash_sales")
}

// -------------------------------------------------------------
// 9. REVIEWS & RATINGS
// -------------------------------------------------------------

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName String
  rating     Int      @default(5)
  comment    String   @db.Text
  isApproved Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([isApproved])
  @@map("reviews")
}

// -------------------------------------------------------------
// 10. BLOG & SEO (Posts & Topics)
// -------------------------------------------------------------

model BlogTopic {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  posts       BlogPost[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@map("blog_topics")
}

model BlogPost {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  content     String     @db.Text
  excerpt     String?
  coverImage  String?
  topicId     String
  topic       BlogTopic  @relation(fields: [topicId], references: [id], onDelete: Restrict)
  authorName  String?    @default("BestApp Team")
  isPublished Boolean    @default(true)
  publishedAt DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([topicId])
  @@index([isPublished])
  @@map("blog_posts")
}

// -------------------------------------------------------------
// 11. AUDIT LOG (Security & Admin Operations)
// -------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String   // e.g. "PRODUCT_CREATE", "STOCK_IMPORT", "ORDER_REFUND"
  entityType String   // "PRODUCT", "ORDER", "LICENSE", "USER"
  entityId   String?
  metadata   Json?
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@map("audit_logs")
}
