// Prisma schema for Two-Sided 3D Printing Marketplace (3D Print Hub)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  CUSTOMER     // Khách hàng có nhu cầu in 3D
  WORKSHOP     // Doanh nghiệp / Xưởng in 3D chuyên nghiệp
  INDIVIDUAL   // Cá nhân có máy in 3D nhận đơn tự do
  ADMIN        // Quản trị viên hệ thống
  SUPPORT      // Hỗ trợ viên
}

enum PrinterType {
  FDM          // Fused Deposition Modeling (In sợi nhựa PLA, ABS, PETG, TPU)
  SLA_RESIN    // Stereolithography (In quang hóa Resin độ chi tiết cao)
  SLS          // Selective Laser Sintering (In bột laser công nghiệp Nylon)
  MJF          // Multi Jet Fusion
  DLP          // Digital Light Processing
}

enum MaterialType {
  PLA          // Nhựa sinh học tiêu chuẩn
  ABS          // Nhựa chịu nhiệt, chịu va đập
  PETG         // Nhựa bền cơ tính, chống ẩm
  RESIN_STD    // Resin tiêu chuẩn cho mô hình anime/art
  RESIN_TOUGH  // Resin kỹ thuật chịu lực
  TPU_FLEX     // Nhựa dẻo đàn hồi cao
  NYLON_PA12   // Nylon công nghiệp độ bền tối đa
  CARBON_FIBER // Nhựa gia cường sợi Carbon siêu cứng
  PEEK         // Nhựa siêu kỹ thuật
}

enum PrinterStatus {
  AVAILABLE    // Đang rảnh - sẵn sàng nhận đơn ngay
  BUSY         // Đang bận chạy máy
  OFFLINE      // Tạm ngưng nhận đơn
}

enum ProjectCategory {
  PROTOTYPE    // Tạo mẫu linh kiện kỹ thuật & cơ khí
  FIGURE_ANIME // Mô hình nhân vật, tượng, decor
  ARCHITECTURE // Sa bàn kiến trúc & xây dựng
  JEWELRY      // Trang sức đúc khuôn & y tế
  ACCESSORIES  // Phụ kiện gia dụng & cosplay
  OTHER        // Khác
}

enum ProjectStatus {
  DRAFT        // Bản nháp
  OPEN         // Đang phát thông báo tìm 10 xưởng gần nhất
  ASSIGNED     // Đã có 1 xưởng/cá nhân nhận đơn
  CONTRACTED   // Đã chốt hợp đồng & thanh toán giữ tiền (Escrow)
  PRINTING     // Đang in sản phẩm
  PRINTED_DONE // Đã in xong, kiểm tra chất lượng (QC)
  SHIPPING     // Đang gửi hàng qua bưu cục/shipper
  COMPLETED    // Khách xác nhận nhận hàng, giải ngân tiền
  CANCELLED    // Huỷ đơn
}

enum InvitationStatus {
  PENDING      // Chờ phản hồi từ xưởng
  ACCEPTED     // Đã nhận đơn thành công
  EXPIRED      // Quá hạn hoặc xưởng khác đã nhận trước
  DECLINED     // Từ chối nhận
}

enum ContractStatus {
  DRAFT
  SENT_TO_CUSTOMER
  PAID_ESCROW
  IN_PRODUCTION
  COMPLETED
  DISPUTED
}

enum EscrowStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED_TO_PRINTER
  REFUNDED_TO_CUSTOMER
}

enum FileType {
  STL
  OBJ
  THREE_MF
  STEP
  IMAGE
  DOCUMENT
}

// -----------------------------------------------------------------------------
// USER & AUTHENTICATION
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  phone         String?
  avatar        String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  balance       Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Quan hệ
  printerProfile    PrinterProfile?
  projectsCreated   Project[]            @relation("CustomerProjects")
  messagesSent      Message[]
  contractsCustomer Contract[]           @relation("CustomerContracts")
  reviewsWritten    Review[]             @relation("ReviewAuthor")
  reviewsReceived   Review[]             @relation("ReviewTarget")
  notifications     Notification[]
  accounts          Account[]
  sessions          Session[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// WORKSHOP / INDIVIDUAL PRINTER PROFILE (TopCV-style)
// -----------------------------------------------------------------------------

model PrinterProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  businessName      String        // Tên xưởng hoặc Tên hiển thị cá nhân
  bio               String?       // Giới thiệu kinh nghiệm, trang thiết bị
  avatar            String?
  coverImage        String?
  
  // Địa chỉ & Tọa độ để tính khoảng cách
  address           String        // Số nhà, tên đường
  district          String        // Quận / Huyện (VD: Quận 1, Cầu Giấy)
  province          String        // Tỉnh / Thành phố (VD: TP. Hồ Chí Minh, Hà Nội)
  latitude          Float         @default(10.7769) // Tọa độ vĩ độ
  longitude         Float         @default(106.7009) // Tọa độ kinh độ

  // Năng lực in 3D
  printerTypes      PrinterType[] // [FDM, SLA_RESIN, SLS]
  materials         MaterialType[] // [PLA, ABS, PETG, RESIN_STD, TPU_FLEX]
  machineCount      Int           @default(1)
  machineModels     String?       // VD: Bambu Lab X1C, Prusa MK4, Anycubic Photon Mono
  maxVolumeX        Int           @default(256) // mm
  maxVolumeY        Int           @default(256) // mm
  maxVolumeZ        Int           @default(256) // mm

  // Trạng thái vận hành
  status            PrinterStatus @default(AVAILABLE)
  isVerified        Boolean       @default(false)
  
  // Đánh giá & Uy tín
  rating            Float         @default(5.0)
  ratingCount       Int           @default(0)
  completedJobs     Int           @default(0)
  responseTimeMin   Int           @default(15) // Phút phản hồi trung bình

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Quan hệ
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations       ProjectInvitation[]
  assignedProjects  Project[]     @relation("AssignedPrinterProjects")
  contracts         Contract[]    @relation("PrinterContracts")

  @@index([province, district])
  @@index([status])
  @@index([rating])
}

// -----------------------------------------------------------------------------
// 3D PRINTING PROJECT (Yêu cầu in của khách hàng)
// -----------------------------------------------------------------------------

model Project {
  id                String          @id @default(uuid())
  code              String          @unique // VD: PRJ-102938
  title             String          // VD: In vỏ hộp thiết bị IoT chống nước
  description       String          // Mô tả chi tiết yêu cầu
  category          ProjectCategory @default(PROTOTYPE)

  // Thông số kỹ thuật mong muốn
  desiredMaterial   MaterialType    @default(PLA)
  desiredColor      String?         // Màu sắc (Trắng, Đen, Xám, Trong suốt...)
  infillPercent     Int?            @default(20) // Độ đặc (%)
  layerHeight       Float?          @default(0.2) // Độ mịn lớp in (mm)
  quantity          Int             @default(1)

  // Ngân sách & Thời hạn
  targetBudget      Float?          // Ngân sách dự kiến (VND), null = Thương lượng
  isNegotiable      Boolean         @default(true)
  deadline          DateTime?       // Thời gian mong muốn hoàn thành

  // Địa chỉ nhận hàng & Tọa độ khách hàng
  deliveryAddress   String          // Địa chỉ giao hàng
  district          String          // Quận / Huyện
  province          String          // Tỉnh / Thành phố
  latitude          Float           @default(10.7769)
  longitude         Float           @default(106.7009)

  status            ProjectStatus   @default(OPEN)
  
  // Quan hệ khách hàng & xưởng nhận
  customerId        String
  customer          User            @relation("CustomerProjects", fields: [customerId], references: [id], onDelete: Cascade)
  
  assignedPrinterId String?
  assignedPrinter   PrinterProfile? @relation("AssignedPrinterProjects", fields: [assignedPrinterId], references: [id])
  
  assignedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Danh sách các thực thể liên quan
  files             ProjectFile[]
  invitations       ProjectInvitation[]
  conversations     Conversation[]
  contract          Contract?
  review            Review?

  @@index([code])
  @@index([status])
  @@index([customerId])
  @@index([assignedPrinterId])
  @@index([province, district])
}

// -----------------------------------------------------------------------------
// PROJECT FILES (Model 3D STL/OBJ & Hình ảnh mẫu)
// -----------------------------------------------------------------------------

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String
  fileName    String   // VD: gear_bracket_v2.stl
  fileUrl     String   // Đường dẫn tải file (R2/S3/Uploadthing)
  fileSize    Int?     // Bytes
  fileType    FileType @default(STL)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// -----------------------------------------------------------------------------
// PROJECT INVITATION (Phát đơn cho 10 bên gần nhất)
// -----------------------------------------------------------------------------

model ProjectInvitation {
  id               String           @id @default(uuid())
  projectId        String
  printerProfileId String
  distanceKm       Float            // Khoảng cách từ khách đến xưởng (km)
  status           InvitationStatus @default(PENDING)
  sentAt           DateTime         @default(now())
  respondedAt      DateTime?

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  printerProfile   PrinterProfile   @relation(fields: [printerProfileId], references: [id], onDelete: Cascade)

  @@unique([projectId, printerProfileId])
  @@index([status])
  @@index([printerProfileId])
}

// -----------------------------------------------------------------------------
// CHAT & MESSAGING (Customer ↔ Workshop/Individual)
// -----------------------------------------------------------------------------

model Conversation {
  id          String    @id @default(uuid())
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([projectId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// -----------------------------------------------------------------------------
// E-CONTRACT & ESCROW PAYMENT (Hợp đồng điện tử & Ký gửi thanh toán)
// -----------------------------------------------------------------------------

model Contract {
  id               String         @id @default(uuid())
  contractCode     String         @unique // VD: HD-849201
  projectId        String         @unique
  customerId       String
  printerProfileId String

  // Điều khoản & Chi phí
  finalPrice       Float          // Tổng giá trị in (VND)
  depositAmount    Float          // Tiền cọc/escrow giữ
  platformFee      Float          @default(0) // Phí nền tảng (VD: 5%)
  netPrinterAmount Float          // Tiền thực nhận của xưởng
  estimatedDays    Int            @default(2) // Số ngày in dự kiến
  materialUsed     String         // Vật liệu cam kết sử dụng
  qualityNotes     String?        // Yêu cầu xử lý bề mặt, bảo hành
  terms            String?        // Điều khoản hợp đồng chuẩn

  status           ContractStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  signedAt         DateTime?
  completedAt      DateTime?

  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer         User           @relation("CustomerContracts", fields: [customerId], references: [id])
  printerProfile   PrinterProfile @relation("PrinterContracts", fields: [printerProfileId], references: [id])
  escrow           EscrowTransaction?

  @@index([contractCode])
  @@index([status])
}

model EscrowTransaction {
  id              String       @id @default(uuid())
  contractId      String       @unique
  amount          Float
  status          EscrowStatus @default(PENDING)
  paymentMethod   String       @default("VIETQR_BANK_TRANSFER")
  paymentRef      String       @unique // Mã chuyển khoản SePay/VietQR
  paidAt          DateTime?
  releasedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contract        Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([paymentRef])
  @@index([status])
}

// -----------------------------------------------------------------------------
// REVIEWS & REPUTATION
// -----------------------------------------------------------------------------

model Review {
  id          String   @id @default(uuid())
  projectId   String   @unique
  authorId    String   // Khách hàng đánh giá
  targetId    String   // User của Xưởng/Cá nhân nhận đánh giá
  rating      Int      @default(5) // 1 - 5 sao
  content     String?
  accuracy    Int?     @default(5) // Độ chính xác kích thước
  finishScore Int?     @default(5) // Độ mịn bề mặt
  images      String[]
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id])

  @@index([targetId])
  @@index([rating])
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  link      String?
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
